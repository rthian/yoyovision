# ---------------------------------------------------------------------------
# YoYoVision - sample environment file. Copy to .env and fill in real values.
# NEVER commit a real .env file. This file must never contain live secrets.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=yoyovision
POSTGRES_PASSWORD=yoyovision_dev_password
POSTGRES_DB=yoyovision
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://yoyovision:yoyovision_dev_password@postgres:5432/yoyovision

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth (MVP dev-only JWT auth, NOT production-grade SSO) ---
AUTH_JWT_SECRET=change-me-dev-only-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRE_MINUTES=1440
AUTH_DEV_SEED_USER_EMAIL=dev@yoyovision.local
AUTH_DEV_SEED_USER_PASSWORD=change-me-dev-only-password

# --- Storage ---
# storage backend: "local" or "s3"
# For `docker compose`, storage is always /data/storage inside containers
# (see docker-compose.yml). Use /tmp/yoyovision_storage only for bare-metal
# local dev (API + worker run directly on the host, not in Docker).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/storage
STORAGE_MAX_UPLOAD_BYTES=524288000
STORAGE_MAX_DURATION_MS=600000

# S3-compatible (used when STORAGE_BACKEND=s3; MinIO locally for parity testing)
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=yoyovision-videos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRE_SECONDS=900

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=60

# --- ML / pipeline ---
PIPELINE_VERSION=0.1.0-dev
RULESET_VERSION=1a-draft-0.1
MOCK_INFERENCE_SEED=42

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Worker perception adapters (see docs/adapters.md) ---
# mock | mediapipe (pose/hand), mock | kalman (tracker)
PIPELINE_POSE_ADAPTER=mock
PIPELINE_HAND_ADAPTER=mock
PIPELINE_YOYO_ADAPTER=mock
PIPELINE_TRACKER_ADAPTER=mock
PIPELINE_TEMPORAL_EVENT_ADAPTER=mock
PIPELINE_TRACKER_MAX_GAP_MS=500
PIPELINE_TRACKER_STATIC_CAMERA=false
